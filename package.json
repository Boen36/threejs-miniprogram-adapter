{
  "name": "threejs-miniprogram-adapter",
  "version": "1.0.0",
  "description": "Modular adapter for using three.js in WeChat Mini Program",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "types/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check:syntax": "find src examples tests -path '*/node_modules' -prune -o -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:types": "tsc --noEmit --strict --target ES2020 --module NodeNext --moduleResolution NodeNext tests/types.test.ts",
    "check:package": "publint && npm pack --dry-run",
    "check": "npm run check:syntax && npm test && npm run check:types && npm run check:package",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "three.js",
    "wechat",
    "miniprogram",
    "webgl",
    "adapter"
  ],
  "author": "Boen36",
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.160.0 <0.186.0"
  },
  "devDependencies": {
    "publint": "0.3.23",
    "typescript": "7.0.2",
    "three": "0.185.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boen36/threejs-miniprogram-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/Boen36/threejs-miniprogram-adapter/issues"
  },
  "homepage": "https://github.com/Boen36/threejs-miniprogram-adapter#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
